---
import '../styles/global.css';
import '../styles/home.css';
import '../styles/home-hero.css';
import '../styles/case-study.css';
import About from '../components/About.astro';
import CaseFooter from '../components/CaseFooter.astro';
import FontLinks from '../components/FontLinks.astro';
import SiteHeader from '../components/SiteHeader.astro';
import LocaleRedirect from '../components/LocaleRedirect.astro';
import { getCaseStudies } from '../data/site';
import { getLocaleUrl, getLocalizedPath, type Locale } from '../i18n/locale';
// import codeXmlIcon from '../assets/code-xml.svg';

interface Props {
  locale?: Locale;
}

const { locale = 'ja' } = Astro.props;
const caseStudies = getCaseStudies(locale);
const materials = ['gem', 'sea-glass', 'rough-glass', 'glass'] as const;
const ogTitle = locale === 'ja'
  ? 'Ayana Yamazaki｜複雑な現場を、動くプロダクトへ翻訳'
  : 'Ayana Yamazaki | Product Builder and Product Designer';
const ogDescription = locale === 'ja'
  ? '現場調査から課題定義、ロードマップ、プロトタイピング、UI設計まで。AIとコードを使い、作るべきものを触れる仕様へ変えるProduct Builder / Product Designer 山崎文菜のポートフォリオ'
  : 'Ayana Yamazaki is a product builder and product designer who turns complex frontline operations into tangible, testable products through research, product definition, prototyping, and code.';
const canonicalUrl = getLocaleUrl('/', locale);
const japaneseUrl = getLocaleUrl('/', 'ja');
const englishUrl = getLocaleUrl('/', 'en');
const transparentPixel = 'data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={ogDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <FontLinks />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale === 'ja' ? 'ja_JP' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'ja' ? 'en_US' : 'ja_JP'} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="ja" href={japaneseUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="x-default" href={japaneseUrl} />
    <LocaleRedirect locale={locale} />
    <title>Ayana Yamazaki — Product Builder</title>
    <script>
      import '../scripts/home-carousel';

      let materialsPromise: Promise<unknown> | undefined;
      const loadMaterials = () => {
        materialsPromise ??= import('../scripts/materials-pbr');
        return materialsPromise;
      };

      const isSmallViewport = window.matchMedia('(max-width: 720px)').matches;
      const requestDeferredMaterials = () => {
        window.setTimeout(() => {
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(
              () => void loadMaterials(),
              { timeout: isSmallViewport ? 2_000 : 1_200 },
            );
          } else {
            window.setTimeout(
              () => void loadMaterials(),
              isSmallViewport ? 400 : 200,
            );
          }
        }, isSmallViewport ? 120 : 0);
      };

      if (isSmallViewport) {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => void loadMaterials());
        });
      } else {
        requestDeferredMaterials();
      }

      const cases = document.querySelector('[data-case-carousel]');
      const loadMaterialsForInteraction = () => void loadMaterials();
      cases?.addEventListener('pointerdown', loadMaterialsForInteraction, {
        once: true,
        passive: true,
      });
      cases?.addEventListener('pointerover', loadMaterialsForInteraction, {
        once: true,
        passive: true,
      });
      cases?.addEventListener('focusin', loadMaterialsForInteraction, {
        once: true,
      });
    </script>
  </head>
  <body id="top">
    <SiteHeader locale={locale} />
    <main class="home-main">
      <section class="home-hero" aria-labelledby="home-title">
        <svg class="material-filters" aria-hidden="true">
          <defs>
            <filter id="material-rough-glass-surface" x="-20%" y="-20%" width="140%" height="140%">
              <feTurbulence type="fractalNoise" baseFrequency=".012 .026" numOctaves="4" seed="31" result="cloud" />
              <feDisplacementMap in="SourceGraphic" in2="cloud" scale="7" xChannelSelector="R" yChannelSelector="G" result="warped" />
              <feColorMatrix in="cloud" values="
                1 0 0 0 .18
                0 .72 0 0 .08
                0 0 .58 0 .04
                0 0 0 .3 0" result="amber-cloud" />
              <feBlend in="warped" in2="amber-cloud" mode="screen" result="clouded" />
              <feSpecularLighting in="cloud" surfaceScale="5" specularConstant=".45" specularExponent="26" lighting-color="#fff7e9" result="rough-glass-specular">
                <fePointLight x="-120" y="-180" z="260" />
              </feSpecularLighting>
              <feComposite in="rough-glass-specular" in2="SourceAlpha" operator="in" result="rough-glass-specular-clipped" />
              <feBlend in="clouded" in2="rough-glass-specular-clipped" mode="screen" />
            </filter>

          </defs>
        </svg>

        <header class="home-hero__heading">
          <div class="home-hero__intro">
            <p class="home-hero__name">Ayana Yamazaki</p>
            <p class="home-hero__role" aria-label="Product Builder / Product Designer">
              <span class="home-hero__role-primary">
                <span>Product Builder</span>
                <span class="home-hero__role-separator" aria-hidden="true">/</span>
              </span>
              <span class="home-hero__role-secondary" aria-hidden="true">Product Designer</span>
            </p>
            <p class="home-hero__description">
              {locale === 'ja'
                ? '複雑な現場を、動くプロダクトへ翻訳する'
                : 'Turning complex frontline work into products that work'}
            </p>
            <p class="home-hero__capability">
              {locale === 'ja'
                ? '現場理解から課題定義、ロードマップ、コードベースのプロトタイプ・一部実装までを横断します。'
                : 'From field research and product definition to roadmaps, code-based prototypes, and implementation.'}
            </p>
          </div>
        </header>

        <div class="home-hero__cases" aria-label="Case studies">
          <picture>
            <source
              media="(min-width: 721px)"
              srcset="/images/optimized/nanakamado-960.avif 960w, /images/optimized/nanakamado-1600.avif 1600w, /images/optimized/nanakamado-2400.avif 2400w"
              sizes="100vw"
              type="image/avif"
            />
            <source
              media="(min-width: 721px)"
              srcset="/images/optimized/nanakamado-960.webp 960w, /images/optimized/nanakamado-1600.webp 1600w, /images/optimized/nanakamado-2400.webp 2400w"
              sizes="100vw"
              type="image/webp"
            />
            <img
              class="home-hero__backdrop-image"
              src={transparentPixel}
              width="3170"
              height="1344"
              alt=""
              aria-hidden="true"
              data-glass-backdrop-image-source
              fetchpriority="high"
            />
          </picture>
          {/* <h1 class="home-hero__title" id="home-title" data-glass-refraction-source>
            <span>THE WAY <br />I BUILD</span>
          </h1> */}
          <canvas
            class="home-hero__materials-canvas"
            aria-hidden="true"
            data-materials-pbr
            data-renderer-state="deferred"
          ></canvas>
          <div class="home-hero__case-track" data-case-carousel>
            {caseStudies.map((caseStudy, index) => (
              <a class="home-hero__case" href={getLocalizedPath(caseStudy.href, locale)} data-material={materials[index]}>
                <span class="home-hero__card-wrap">
                  <span class={`home-hero__card material-card material-card--${materials[index]}`} aria-hidden="true">
                  <span class="material-card__shadow" hidden></span>
                  <span class="material-card__volume" hidden>
                    <span class="material-card__front">
                      <span class="material-card__surface"></span>
                      <span class="material-card__sheen"></span>
                    </span>
                    <span class="material-card__side material-card__side--right"></span>
                    <span class="material-card__side material-card__side--bottom"></span>
                  </span>
                  {/* {materials[index] === 'glass' && (
                    <img class="material-card__glass-icon" src={codeXmlIcon.src} alt="" />
                  )} */}
                  </span>
                  <span class="home-hero__case-copy">
                    <span class="home-hero__case-title">
                      {materials[index] === 'gem'
                        ? <><span class="home-hero__embedded-title-strong">Reframe</span><br />the Problem</>
                        : materials[index] === 'sea-glass'
                          ? <>What to<br />Build</>
                        : materials[index] === 'rough-glass'
                          ? <><span class="home-hero__embedded-title-strong">Prototype</span><br />&amp; <span class="home-hero__embedded-title-strong">Iterate</span></>
                          : materials[index] === 'glass'
                            ? <>Build<br /><span class="home-hero__embedded-title-strong">AI-Native</span></>
                            : caseStudy.title}
                    </span>
                    <span class="home-hero__case-text">
                      {caseStudy.text.split('\n').map((line, lineIndex, lines) => (
                        <>{line}{lineIndex < lines.length - 1 && <br />}</>
                      ))}
                    </span>
                    <span class="home-hero__case-link">Case study ↗︎</span>
                  </span>
                </span>
              </a>
            ))}
          </div>
          <div class="home-hero__case-progress" aria-hidden="true">
            <span class="home-hero__case-progress-current" data-case-current>01</span>
            <span class="home-hero__case-progress-bar">
              <span data-case-progress></span>
            </span>
            <span>{String(caseStudies.length).padStart(2, '0')}</span>
          </div>
        </div>
      </section>
      <About locale={locale} />
    </main>
    <CaseFooter locale={locale} />

  </body>
</html>
