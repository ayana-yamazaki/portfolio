---
import '../styles/global.css';
import About from '../components/About.astro';
import HeroAlt2 from '../components/HeroAlt2.astro';
import SelectedProjects from '../components/SelectedProjects.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Ayana Yamazaki — Product Builder" />
    <title>Ayana Yamazaki — Product Builder</title>
  </head>
  <body>
    <main class="alternate2-main">
      <HeroAlt2 />
      <SelectedProjects />
      <About />
    </main>
  </body>
</html>

<style is:global>
  body:has(.alternate2-main) {
    overflow-x: clip;
  }

  .alternate2-main {
    overflow: visible;
  }
</style>
