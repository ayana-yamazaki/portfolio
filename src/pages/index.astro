---
import '../styles/global.css';
import '../styles/home.css';
import '../styles/case-study.css';
import About from '../components/About.astro';
import CaseFooter from '../components/CaseFooter.astro';
import HeroAlt2 from '../components/HeroAlt2.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Ayana Yamazaki — Product Builder" />
    <title>Ayana Yamazaki — Product Builder</title>
  </head>
  <body id="top">
    <main class="home-main">
      <HeroAlt2 />
      <About />
    </main>
    <CaseFooter />
  </body>
</html>

<style is:global>
  body:has(.home-main) {
    overflow-x: clip;
  }

  .home-main {
    overflow: visible;
  }
</style>
