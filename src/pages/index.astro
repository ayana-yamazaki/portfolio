---
import '../styles/global.css';
import '../styles/home.css';
import '../styles/home-hero.css';
import '../styles/case-study.css';
import About from '../components/About.astro';
import CaseFooter from '../components/CaseFooter.astro';
import { caseStudies } from '../data/site';
import heroAbstract from '../assets/hero-abstract.svg';

const materials = ['stone', 'paper', 'resin', 'glass'] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Ayana Yamazaki — Product Builder" />
    <title>Ayana Yamazaki — Product Builder</title>
  </head>
  <body id="top">
    <main class="home-main">
      <section class="home-hero" aria-labelledby="home-title">
        <svg class="material-filters" aria-hidden="true">
          <defs>
            <filter id="material-stone-grain" x="-15%" y="-15%" width="130%" height="130%">
              <feTurbulence type="fractalNoise" baseFrequency=".52" numOctaves="5" seed="19" result="noise" />
              <feColorMatrix in="noise" type="saturate" values="0" result="mono-noise" />
              <feComponentTransfer in="mono-noise" result="grain">
                <feFuncR type="linear" slope="1.35" intercept="-.15" />
                <feFuncG type="linear" slope="1.28" intercept="-.12" />
                <feFuncB type="linear" slope="1.18" intercept="-.08" />
                <feFuncA type="table" tableValues="0 .58" />
              </feComponentTransfer>
              <feBlend in="SourceGraphic" in2="grain" mode="soft-light" result="textured" />
              <feDiffuseLighting in="noise" surfaceScale="2.4" diffuseConstant=".72" lighting-color="#fff" result="light">
                <feDistantLight azimuth="225" elevation="48" />
              </feDiffuseLighting>
              <feComposite in="light" in2="SourceAlpha" operator="in" result="clipped-light" />
              <feBlend in="textured" in2="clipped-light" mode="soft-light" />
            </filter>

            <filter id="material-paper-grain" x="-10%" y="-10%" width="120%" height="120%">
              <feTurbulence type="fractalNoise" baseFrequency=".018 .62" numOctaves="4" seed="8" result="fibers" />
              <feColorMatrix in="fibers" values="
                .8 0 0 0 .12
                0 .76 0 0 .11
                0 0 .68 0 .08
                0 0 0 .3 0" result="paper-fibers" />
              <feBlend in="SourceGraphic" in2="paper-fibers" mode="multiply" result="fiber-paper" />
              <feDiffuseLighting in="fibers" surfaceScale=".55" diffuseConstant=".85" lighting-color="#fff" result="paper-light">
                <feDistantLight azimuth="218" elevation="58" />
              </feDiffuseLighting>
              <feComposite in="paper-light" in2="SourceAlpha" operator="in" result="paper-light-clipped" />
              <feBlend in="fiber-paper" in2="paper-light-clipped" mode="screen" />
            </filter>

            <filter id="material-resin-cloud" x="-20%" y="-20%" width="140%" height="140%">
              <feTurbulence type="fractalNoise" baseFrequency=".012 .026" numOctaves="4" seed="31" result="cloud" />
              <feDisplacementMap in="SourceGraphic" in2="cloud" scale="7" xChannelSelector="R" yChannelSelector="G" result="warped" />
              <feColorMatrix in="cloud" values="
                1 0 0 0 .18
                0 .72 0 0 .08
                0 0 .58 0 .04
                0 0 0 .3 0" result="amber-cloud" />
              <feBlend in="warped" in2="amber-cloud" mode="screen" result="clouded" />
              <feSpecularLighting in="cloud" surfaceScale="5" specularConstant=".45" specularExponent="26" lighting-color="#fff7e9" result="resin-specular">
                <fePointLight x="-120" y="-180" z="260" />
              </feSpecularLighting>
              <feComposite in="resin-specular" in2="SourceAlpha" operator="in" result="resin-specular-clipped" />
              <feBlend in="clouded" in2="resin-specular-clipped" mode="screen" />
            </filter>

            <filter id="material-frosted-glass" x="-10%" y="-10%" width="120%" height="120%">
              <feTurbulence type="fractalNoise" baseFrequency=".72" numOctaves="4" seed="47" result="frost" />
              <feColorMatrix in="frost" type="saturate" values="0" result="frost-mono" />
              <feComponentTransfer in="frost-mono" result="frost-grain">
                <feFuncR type="linear" slope=".54" intercept=".42" />
                <feFuncG type="linear" slope=".58" intercept=".44" />
                <feFuncB type="linear" slope=".62" intercept=".46" />
                <feFuncA type="table" tableValues="0 .14" />
              </feComponentTransfer>
              <feBlend in="SourceGraphic" in2="frost-grain" mode="screen" result="frosted" />
              <feDiffuseLighting in="frost" surfaceScale=".7" diffuseConstant=".75" lighting-color="#f5ffff" result="frost-light">
                <feDistantLight azimuth="220" elevation="62" />
              </feDiffuseLighting>
              <feComposite in="frost-light" in2="SourceAlpha" operator="in" result="frost-light-clipped" />
              <feBlend in="frosted" in2="frost-light-clipped" mode="soft-light" />
            </filter>
          </defs>
        </svg>

        <header class="home-hero__heading">
          <p>Ayana Yamazaki</p>
          <h1 id="home-title">Product Builder</h1>
          <p>UI/UX Designer</p>
        </header>

        <img class="home-hero__backdrop" src={heroAbstract.src} alt="" aria-hidden="true" data-hero-backdrop />

        <div class="home-hero__cases" aria-label="Case studies">
          {caseStudies.map((caseStudy, index) => (
            <a class="home-hero__case" href={caseStudy.href}>
              <span class={`home-hero__card material-card material-card--${materials[index]}`} aria-hidden="true">
                <span class="material-card__shadow"></span>
                <span class="material-card__volume">
                  <span class="material-card__front">
                    <span class="material-card__surface"></span>
                    <span class="material-card__sheen"></span>
                  </span>
                  <span class="material-card__side material-card__side--right"></span>
                  <span class="material-card__side material-card__side--bottom"></span>
                  {materials[index] === 'glass' && (
                    <canvas
                      class="material-card__glass-canvas"
                      aria-hidden="true"
                      data-glass-pbr
                      data-texture-src={heroAbstract.src}
                      data-blur-step="18"
                      data-rim-width="30"
                      data-rim-displacement="50"
                      data-scatter-strength="3.2"
                      data-frost-amount="0.8"
                      data-veil-opacity="0.16"
                      data-corner-radius="38"
                      data-light-x="-0.68"
                      data-light-y="0.74"
                      data-base-tilt="-7"
                      data-base-yaw="-2.2"
                      data-hover-tilt="-3"
                      data-hover-yaw="0.2"
                      data-debug-mode="final"
                    ></canvas>
                  )}
                </span>
              </span>
              <span class="home-hero__case-title">{caseStudy.title}</span>
              <span class="home-hero__case-text">{caseStudy.text.replace(/。$/, '')}</span>
            </a>
          ))}
        </div>
      </section>
      <About />
    </main>
    <CaseFooter />

    <script>
      import '../scripts/glass-pbr';
    </script>
  </body>
</html>
