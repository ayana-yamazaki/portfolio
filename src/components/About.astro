---
import { getAbout } from '../data/site';
import type { Locale } from '../i18n/locale';
import ResponsiveImage from './ResponsiveImage.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const about = getAbout(locale);
---

<section id="about" class="about" aria-labelledby="about-title">
  <h2 id="about-title" class="home-section-heading" data-reveal>{about.label}</h2>
  <div class="about-intro" data-reveal>
    <div class="case-prose case-prose--full">
      {about.description.map((line) => <p>{line}</p>)}
      <p class="about-award">
        <strong>
          {locale === 'ja'
            ? 'GOOD DESIGN AWARD 2025　グッドデザイン金賞 (トップ20)'
            : 'GOOD DESIGN AWARD 2025 Gold Award (Top 20)'}
        </strong>
      </p>
    </div>
    <ResponsiveImage
      base="/images/optimized/profile"
      widths={[360, 720, 1080]}
      width={3598}
      height={3598}
      sizes="(max-width: 720px) 64vw, 360px"
      alt={locale === 'ja' ? '山崎文菜のプロフィール写真' : 'Portrait of Ayana Yamazaki'}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="experience">
    <h3 class="home-section-heading" data-reveal>Experience</h3>
    <div class="experience-list">
      {about.experience.map((item) => (
        <article class="experience-item" data-reveal>
          <p class="experience-period">{item.period}</p>
          <div>
            <h4>{item.organization}</h4>
            {item.description && <p>{item.description}</p>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
