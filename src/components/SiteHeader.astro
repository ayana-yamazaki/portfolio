---
import { pillars } from '../data/site';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-header__group">
    <a class="site-header__brand" href="/">Ayana Yamazaki</a>
    <nav class="site-header__sections" aria-label="Case studies">
      {pillars.map((pillar) => {
        const selected = currentPath === pillar.href;
        return (
          <a class:list={{ selected }} href={pillar.href} aria-current={selected ? 'page' : undefined}>
            <span>{pillar.number}</span>{pillar.title}
          </a>
        );
      })}
    </nav>
  </div>

  <nav class="site-header__nav" aria-label="Global navigation">
    <a href="/#about">About</a>
    <a
      class="site-header__x"
      href="https://x.com/ayana_yamazaki"
      target="_blank"
      rel="noreferrer"
      aria-label="Ayana Yamazaki on X"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.657l-5.214-6.817-5.966 6.817H1.68l7.73-8.835L1.254 2.25h6.826l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z" />
      </svg>
    </a>
  </nav>
</header>
<div class="site-header-spacer" aria-hidden="true"></div>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  let previousScrollY = window.scrollY;

  const updateHeader = () => {
    const currentScrollY = window.scrollY;

    if (currentScrollY <= 0 || currentScrollY >= previousScrollY) {
      header?.classList.remove('site-header--hidden');
    } else {
      header?.classList.add('site-header--hidden');
    }

    previousScrollY = currentScrollY;
  };

  window.addEventListener('scroll', updateHeader, { passive: true });
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    width: 100%;
    height: 52px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    padding: 0 clamp(24px, 7vw, 112px);
    border-bottom: 1px solid var(--divider-color);
    background: #fff;
    transform: translateY(0);
    transition: transform .3s ease;
  }

  .site-header--hidden {
    transform: translateY(-100%);
  }

  .site-header-spacer {
    height: 52px;
  }

  .site-header__group,
  .site-header__nav {
    display: flex;
    height: 100%;
    align-items: center;
    gap: clamp(20px, 3vw, 48px);
  }

  .site-header__sections {
    display: flex;
    height: 100%;
    align-items: center;
    gap: clamp(12px, 1.6vw, 24px);
  }

  .site-header a {
    color: inherit;
    font-size: 16px;
    text-decoration: none;
    transition: color .2s ease;
  }

  .site-header a:hover,
  .site-header a:focus-visible {
    color: var(--accent-color);
  }

  .site-header__brand {
    font-weight: 600;
    letter-spacing: -.02em;
  }

  .site-header__sections a {
    position: relative;
    display: flex;
    height: 100%;
    align-items: center;
    gap: 8px;
    padding: 0;
    font-size: clamp(11px, 1vw, 14px);
    white-space: nowrap;
  }

  .site-header__sections a.selected {
    color: var(--accent-color);
    font-weight: 500;
  }

  .site-header__sections span {
    color: var(--accent-color);
    font-size: 11px;
    letter-spacing: .06em;
  }

  .site-header__x {
    display: grid;
    width: 24px;
    height: 24px;
    place-items: center;
  }

  .site-header__x svg {
    display: block;
    width: 19px;
    height: 19px;
    fill: currentColor;
  }

  @media (max-width: 640px) {
    .site-header {
      align-items: center;
      gap: 20px;
    }

    .site-header__group {
      align-items: center;
      flex-direction: row;
    }

    .site-header__sections {
      align-items: center;
      flex-direction: row;
    }

    .site-header__nav {
      gap: 18px;
    }

    .site-header-spacer {
      height: 52px;
    }
  }
</style>
