---
import { getCaseStudies } from '../data/site';
import { getLocalizedPath, stripLocalePrefix, type Locale } from '../i18n/locale';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const caseStudies = getCaseStudies(locale);
const currentPath = stripLocalePrefix(Astro.url.pathname);
const revealOnScroll = currentPath === '/';
const isCaseStudy = caseStudies.some((caseStudy) => currentPath === caseStudy.href);
---

<header
  class:list={[
      'site-header',
      {
        'site-header--reveal-on-scroll': revealOnScroll,
        'site-header--visible': !revealOnScroll,
        'site-header--case-study': isCaseStudy,
      },
    ]}
>
  <div class="site-header__group">
    <a class="site-header__brand" href={getLocalizedPath('/', locale)}>Ayana Yamazaki</a>
    <nav class="site-header__sections" aria-label="Case studies">
      {caseStudies.map((caseStudy) => {
        const selected = currentPath === caseStudy.href;
        return (
          <a
            class:list={{ selected }}
            href={getLocalizedPath(caseStudy.href, locale)}
            aria-current={selected ? 'page' : undefined}
            aria-label={`${caseStudy.number} ${caseStudy.title}`}
          >
            <span>{caseStudy.number}</span><span>{caseStudy.title}</span>
          </a>
        );
      })}
    </nav>
  </div>

  <nav class="site-header__nav" aria-label="Global navigation">
    <a class="site-header__about" href={`${getLocalizedPath('/', locale)}#about`}>About</a>
    <a
      class="site-header__x"
      href="https://x.com/ayana_yamazaki"
      target="_blank"
      rel="noreferrer"
      aria-label="Ayana Yamazaki on X"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.657l-5.214-6.817-5.966 6.817H1.68l7.73-8.835L1.254 2.25h6.826l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z" />
      </svg>
    </a>
  </nav>
  <LanguageSwitcher locale={locale} />
</header>
<div class="site-header-spacer" aria-hidden="true"></div>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');

  if (header?.classList.contains('site-header--reveal-on-scroll')) {
    let frameId: number | undefined;
    let isVisible = header.classList.contains('site-header--visible');

    const updateHeader = () => {
      frameId = undefined;
      const revealThreshold = window.innerHeight * .6;
      const hasHeaderFocus = header.contains(document.activeElement);
      const nextVisible = window.scrollY > revealThreshold || hasHeaderFocus;
      if (nextVisible === isVisible) return;
      isVisible = nextVisible;
      header.classList.toggle('site-header--visible', nextVisible);
    };

    const requestHeaderUpdate = () => {
      if (frameId !== undefined) return;
      frameId = requestAnimationFrame(updateHeader);
    };

    updateHeader();
    window.addEventListener('scroll', requestHeaderUpdate, { passive: true });
    window.addEventListener('resize', requestHeaderUpdate, { passive: true });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab' || isVisible) return;
      isVisible = true;
      header.classList.add('site-header--visible');
    });
  } else {
    header?.classList.add('site-header--visible');
  }
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    width: 100%;
    height: 56px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    padding: 0 clamp(24px, 7vw, 112px);
    border-bottom: 1px solid color-mix(in srgb, var(--divider-color) 65%, transparent);
    background: rgb(255 255 255 / 97%);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-18px);
    visibility: hidden;
    transition:
      opacity .4s ease,
      transform .4s cubic-bezier(.22, 1, .36, 1),
      visibility 0s linear .4s;
  }

  .site-header--visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    visibility: visible;
    transition-delay: 0s;
  }

  .site-header-spacer {
    height: 0;
  }

  .site-header__group,
  .site-header__nav {
    display: flex;
    height: 100%;
    align-items: center;
    gap: clamp(20px, 3vw, 48px);
  }

  .site-header__sections {
    display: flex;
    height: 100%;
    align-items: center;
    gap: clamp(18px, 2vw, 32px);
  }

  .site-header__nav {
    margin-left: auto;
  }

  .site-header a {
    color: var(--text-color-secondary);
    font-size: 13px;
    text-decoration: none;
    transition: color .2s ease;
  }

  .site-header .site-header__about {
    font-size: clamp(11px, .9vw, 13px);
  }

  .site-header a:hover,
  .site-header a:focus-visible {
    color: #181818;
  }

  .site-header__brand {
    color: #181818;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -.02em;
  }

  .site-header__sections a {
    position: relative;
    display: flex;
    height: 100%;
    align-items: center;
    gap: 4px;
    padding: 0;
    font-size: clamp(11px, .9vw, 13px);
    font-weight: 400;
    white-space: nowrap;
  }

  .site-header__sections a.selected {
    color: #181818;
  }

  .site-header__sections a.selected::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--accent-color);
  }

  .site-header--case-study .site-header__sections {
    gap: clamp(2px, .5vw, 8px);
  }

  .site-header--case-study .site-header__sections a {
    min-width: 44px;
    min-height: 44px;
    justify-content: center;
    gap: 0;
    padding: 0 10px;
    color: #a0a0a0;
  }

  .site-header--case-study .site-header__sections a:hover,
  .site-header--case-study .site-header__sections a:focus-visible {
    color: #181818;
  }

  .site-header--case-study .site-header__sections a.selected {
    color: #181818;
    font-size: 14px;
    font-weight: 600;
  }

  .site-header--case-study .site-header__sections a.selected::after {
    display: none;
  }

  .site-header--case-study .site-header__sections a > span:first-child::after {
    display: none;
  }

  .site-header--case-study .site-header__sections a > span:first-child {
    color: inherit;
  }

  .site-header--case-study .site-header__sections a > span:last-child {
    display: inline;
    margin-left: 6px;
  }

  .site-header__sections a > span:first-child {
    display: inline-flex;
    gap: 4px;
    align-items: baseline;
    color: var(--accent-color);
    font-size: 11px;
    letter-spacing: .06em;
  }

  .site-header__sections a > span:first-child::after {
    content: '/';
    color: var(--divider-color);
    font-weight: 300;
  }

  .site-header__sections a > span:last-child {
    color: inherit;
  }

  .site-header__x {
    display: grid;
    width: 24px;
    height: 24px;
    place-items: center;
  }

  .site-header__x svg {
    display: block;
    width: 19px;
    height: 19px;
    fill: currentColor;
  }

  @media (max-width: 960px) {
    .site-header__sections {
      gap: 16px;
    }

    .site-header:not(.site-header--case-study) .site-header__sections a > span:last-child {
      display: none;
    }

    .site-header--case-study .site-header__sections a > span:last-child {
      display: none;
      margin-left: 0;
    }

  }

  @media (max-width: 640px) {
    .site-header {
      align-items: center;
      gap: 20px;
      padding-inline: 16px;
    }

    .site-header__group {
      width: 100%;
      align-items: center;
      flex-direction: row;
      gap: 12px;
    }

    .site-header__sections {
      flex: 1;
      align-items: center;
      flex-direction: row;
      gap: 0;
    }

    .site-header__sections a {
      flex: 1;
      justify-content: center;
      padding-inline: 10px;
    }

    .site-header--case-study .site-header__sections a {
      min-width: 40px;
      padding: 0 6px;
    }

    .site-header--case-study .site-header__sections a.selected > span:last-child {
      display: none;
      margin-left: 0;
    }

    .site-header__nav {
      display: none;
    }

    .site-header-spacer {
      height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }
</style>
