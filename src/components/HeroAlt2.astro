---
import panel01Texture from '../../img/panel01-texture.png';
import { hero, pillars } from '../data/site';
---

<section class="hero-alt2" data-scroll-scene data-stage="0" aria-label="How I build">
  <span id="prototype-and-iterate" class="scene-anchor scene-anchor--03" aria-hidden="true"></span>
  <span id="build-ai-native" class="scene-anchor scene-anchor--04" aria-hidden="true"></span>
  <div class="hero-alt2-sticky">
    <div class="hero-alt2-copy">
      <header class="hero-alt2-intro" data-scene-intro>
        <p>{hero.name}</p>
        <h1>{hero.title}</h1>
        <p>How I Build</p>
      </header>

      {pillars.map((card, index) => (
        <article class="detail-copy" data-detail-copy={index} aria-hidden="true">
          <p class="detail-number">{card.number}</p>
          <h2>{card.title}</h2>
          <p class="detail-description">{card.text}</p>
          <a href={card.href}>{card.action} <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>

    <div class="card-stage" aria-hidden="true">
      <div class="stage-card-edge" data-stage-edge>
        <img src={panel01Texture.src} alt="" />
      </div>
      {pillars.map((card, index) => (
        <div class="stage-card" data-stage-card={index}>
          {card.image
            ? <img src={card.image.src} alt={card.alt} />
            : <div class="stage-card-placeholder"><span>Prototype and Iterate</span><small>Image placeholder</small></div>}
        </div>
      ))}
    </div>

    <p class="scroll-cue" data-scroll-cue>Scroll to explore <span aria-hidden="true">↓</span></p>
  </div>
</section>

<script>
  import '../scripts/hero-scroll';
</script>
