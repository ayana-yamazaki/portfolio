---
import panel01 from '../../img/panel01.png';
import panel01Texture from '../../img/panel01-texture.png';
import panel02 from '../../img/panel02.png';
import panel03 from '../../img/panel03.png';

const cards = [
  {
    number: '01',
    title: 'Reframe the Problem',
    text: '前提を疑い、解くべき問題を定める。',
    href: '/reposaku',
    action: 'View Case Study',
    image: panel01,
    alt: 'Working with soil in the field',
  },
  {
    number: '02',
    title: 'Decide What to Build',
    text: '調査と事業課題から、作るべきものと順序を決める。',
    href: '/decide-what-to-build',
    action: 'View Case Study',
    image: panel02,
    alt: 'Dental product interface prototypes',
  },
  {
    number: '03',
    title: 'Prototype and Iterate',
    text: '試作と検証を重ね、0.1秒単位で操作を削り切る。',
    href: '#prototype-and-iterate',
    action: 'Coming Soon',
    image: null,
    alt: '',
  },
  {
    number: '04',
    title: 'Build AI-Native',
    text: 'AIとコードで、仕様の曖昧さを実装前に潰す。',
    href: '#projects',
    action: 'View Projects',
    image: panel03,
    alt: 'Building a product in the terminal',
  },
];
---

<section class="hero-alt2" data-scroll-scene data-stage="0" aria-label="How I build">
  <span id="prototype-and-iterate" class="scene-anchor scene-anchor--03" aria-hidden="true"></span>
  <span id="build-ai-native" class="scene-anchor scene-anchor--04" aria-hidden="true"></span>
  <div class="hero-alt2-sticky">
    <div class="hero-alt2-copy">
      <header class="hero-alt2-intro" data-scene-intro>
        <p>AYANA YAMAZAKI</p>
        <h1>Product Builder</h1>
      </header>

      {cards.map((card, index) => (
        <article class="detail-copy" data-detail-copy={index} aria-hidden="true">
          <p class="detail-number">{card.number}</p>
          <h2>{card.title}</h2>
          <p class="detail-description">{card.text}</p>
          <a href={card.href}>{card.action} <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>

    <div class="card-stage" aria-hidden="true">
      <div class="stage-card-edge" data-stage-edge>
        <img src={panel01Texture.src} alt="" />
      </div>
      {cards.map((card, index) => (
        <div class="stage-card" data-stage-card={index}>
          {card.image
            ? <img src={card.image.src} alt={card.alt} />
            : <div class="stage-card-placeholder"><span>Prototype and Iterate</span><small>Image placeholder</small></div>}
        </div>
      ))}
    </div>

    <p class="scroll-cue" data-scroll-cue>Scroll to explore <span aria-hidden="true">↓</span></p>
  </div>
</section>

<script>
  const scene = document.querySelector<HTMLElement>('[data-scroll-scene]');

  if (scene) {
    const stageCards = Array.from(scene.querySelectorAll<HTMLElement>('[data-stage-card]'));
    const stageEdge = scene.querySelector<HTMLElement>('[data-stage-edge]');
    const detailCopies = Array.from(scene.querySelectorAll<HTMLElement>('[data-detail-copy]'));
    const intro = scene.querySelector<HTMLElement>('[data-scene-intro]');
    const scrollCue = scene.querySelector<HTMLElement>('[data-scroll-cue]');
    const clamp = (value: number, min = 0, max = 1) => Math.min(max, Math.max(min, value));

    const poses = [
      [
        { x: -72, y: 0, rotate: 25, scale: .9, opacity: 1 },
        { x: -24, y: 0, rotate: 25, scale: .87, opacity: 1 },
        { x: 24, y: 0, rotate: 25, scale: .84, opacity: 1 },
        { x: 72, y: 0, rotate: 25, scale: .81, opacity: 1 },
      ],
      [
        { x: 0, y: 0, rotate: 0, scale: 1, opacity: 1 },
        { x: 8, y: 76, rotate: 25, scale: .66, opacity: .52 },
        { x: 13, y: 145, rotate: 25, scale: .62, opacity: .38 },
        { x: 18, y: 208, rotate: 25, scale: .58, opacity: .24 },
      ],
      [
        { x: -30, y: -250, rotate: -16, scale: .7, opacity: .08 },
        { x: 0, y: 0, rotate: 0, scale: 1, opacity: 1 },
        { x: 8, y: 86, rotate: 25, scale: .64, opacity: .46 },
        { x: 14, y: 164, rotate: 25, scale: .6, opacity: .3 },
      ],
      [
        { x: -36, y: -310, rotate: -18, scale: .66, opacity: 0 },
        { x: -30, y: -250, rotate: -16, scale: .7, opacity: .08 },
        { x: 0, y: 0, rotate: 0, scale: 1, opacity: 1 },
        { x: 8, y: 96, rotate: 25, scale: .62, opacity: .42 },
      ],
      [
        { x: -40, y: -340, rotate: -18, scale: .64, opacity: 0 },
        { x: -36, y: -310, rotate: -18, scale: .66, opacity: 0 },
        { x: -30, y: -250, rotate: -16, scale: .7, opacity: .08 },
        { x: 0, y: 0, rotate: 0, scale: 1, opacity: 1 },
      ],
    ];
    const stageThresholds = [.06, .3, .54, .78];
    let renderedStage = -1;
    let ticking = false;

    const render = () => {
      ticking = false;
      const travel = Math.max(1, scene.offsetHeight - window.innerHeight);
      const progress = clamp((window.scrollY - scene.offsetTop) / travel);
      const nextStage = stageThresholds.reduce(
        (stage, threshold) => progress >= threshold ? stage + 1 : stage,
        0,
      );

      if (nextStage === renderedStage) return;
      const firstRender = renderedStage === -1;
      renderedStage = nextStage;
      scene.dataset.stage = String(nextStage);
      const activeIndex = nextStage - 1;

      stageCards.forEach((card, cardIndex) => {
        if (firstRender) card.style.transition = 'none';
        const pose = poses[nextStage][cardIndex];
        card.style.transform = `translate3d(${pose.x}%, ${pose.y}px, 0) rotateY(${pose.rotate}deg) scale(${pose.scale})`;
        card.style.opacity = String(pose.opacity);
      });

      if (stageEdge) {
        if (firstRender) stageEdge.style.transition = 'none';
        const pose = poses[nextStage][0];
        stageEdge.style.transform = `translate3d(calc(${pose.x}% - 12px), ${pose.y + 8}px, 0) rotateY(${pose.rotate}deg) scale(${pose.scale})`;
        stageEdge.style.opacity = nextStage === 0 ? '1' : '0';
      }

      if (firstRender) {
        requestAnimationFrame(() => {
          stageCards.forEach((card) => card.style.removeProperty('transition'));
          stageEdge?.style.removeProperty('transition');
        });
      }

      if (intro) {
        intro.style.opacity = nextStage === 0 ? '1' : '0';
        intro.style.transform = nextStage === 0 ? 'translateY(0)' : 'translateY(-24px)';
      }
      if (scrollCue) scrollCue.style.opacity = nextStage === 0 ? '1' : '0';

      detailCopies.forEach((copy, index) => {
        const active = index === activeIndex;
        copy.classList.toggle('is-active', active);
        copy.setAttribute('aria-hidden', String(!active));
      });
    };

    const requestRender = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(render);
      }
    };

    window.addEventListener('scroll', requestRender, { passive: true });
    window.addEventListener('resize', requestRender);
    render();
  }
</script>

<style>
  .hero-alt2 {
    position: relative;
    height: 250svh;
    padding: 0;
    background: #f6f3f1;
  }

  .scene-anchor { position: absolute; left: 0; width: 1px; height: 1px; pointer-events: none; }
  .scene-anchor--03 { top: 81svh; }
  .scene-anchor--04 { top: 117svh; }

  .hero-alt2-sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    display: grid;
    grid-template-columns: 38% 62%;
    overflow: hidden;
  }

  .hero-alt2-copy {
    position: relative;
    z-index: 6;
    padding: clamp(68px, 10vh, 110px) 24px 48px clamp(24px, 7vw, 112px);
  }

  .hero-alt2-intro,
  .detail-copy {
    position: absolute;
    top: clamp(68px, 10vh, 110px);
    left: clamp(24px, 7vw, 112px);
    width: calc(100% - clamp(48px, 9vw, 136px));
  }

  .hero-alt2-intro { transition: opacity .12s linear, transform .12s linear; }
  .hero-alt2-intro p { margin: 0; font-size: 16px; letter-spacing: .04em; }
  .hero-alt2-intro h1 { margin: 0; font-size: clamp(38px, 7.6vw, 115px); line-height: .88; font-weight: 500; letter-spacing: -.07em; white-space: nowrap; }

  .detail-copy {
    top: 50%;
    opacity: 0;
    pointer-events: none;
    transform: translateY(calc(-50% + 30px));
    transition: opacity .38s ease, transform .65s cubic-bezier(.2, .75, .2, 1);
  }

  .detail-copy.is-active { opacity: 1; pointer-events: auto; transform: translateY(-50%); }
  .detail-number { margin-bottom: clamp(32px, 6vh, 68px); font-size: 11px; letter-spacing: .04em; }
  .detail-copy h2 { max-width: 9ch; margin: 0 0 26px; font-size: clamp(43px, 6vw, 88px); line-height: .9; font-weight: 500; letter-spacing: -.065em; }
  .detail-description { max-width: 32ch; margin: 32px 0; font-size: 14px; line-height: 1.6; }
  .detail-copy a { color: inherit; font-size: 12px; text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 4px; }

  .card-stage {
    position: relative;
    display: grid;
    place-items: center;
    perspective: 1500px;
  }

  .stage-card,
  .stage-card-edge {
    position: absolute;
    width: min(33vw, 420px);
    height: min(72svh, 680px);
  }

  .stage-card {
    overflow: hidden;
    background: #f6f3f1;
    border: 1px solid rgba(255, 255, 255, .75);
    box-shadow: -12px 18px 42px rgba(0, 0, 0, .1);
    transform-origin: center center;
    will-change: transform, opacity;
    transition: transform .52s cubic-bezier(.18, 1.12, .32, 1), opacity .28s ease, background .32s ease, box-shadow .32s ease, border-color .32s ease;
  }

  .stage-card-edge {
    z-index: 0;
    overflow: hidden;
    background: #9a9a9a;
    border-radius: 40px;
    transform-origin: center center;
    will-change: transform, opacity;
    transition: transform .52s cubic-bezier(.18, 1.12, .32, 1), opacity .15s ease;
  }

  .stage-card-edge img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    opacity: .4;
  }

  .stage-card[data-stage-card="0"] { z-index: 3; border-radius: 40px; }
  .stage-card[data-stage-card="1"] { z-index: 2; border-radius: 20px; }
  .stage-card[data-stage-card="2"] { z-index: 1; border-radius: 14px; }
  .stage-card[data-stage-card="3"] { z-index: 0; border-radius: 10px; }
  .hero-alt2[data-stage="0"] .stage-card[data-stage-card="0"] { z-index: 1; }
  .hero-alt2[data-stage="0"] .stage-card[data-stage-card="1"] { z-index: 2; }
  .hero-alt2[data-stage="0"] .stage-card[data-stage-card="2"] { z-index: 3; }
  .hero-alt2[data-stage="0"] .stage-card[data-stage-card="3"] { z-index: 4; }
  .stage-card img { width: 100%; height: 100%; display: block; object-fit: cover; object-position: top; transition: height .42s cubic-bezier(.2, .75, .2, 1), opacity .32s ease; }

  .stage-card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px;
    color: #66635d;
    background: #d6d3ca;
  }

  .stage-card-placeholder span,
  .stage-card-placeholder small { font-size: 11px; line-height: 1.4; letter-spacing: .04em; }

  .hero-alt2[data-stage="0"] .stage-card {
    background: rgba(255, 255, 255, .42);
    border-color: rgba(255, 255, 255, .55);
    backdrop-filter: blur(20px) saturate(130%);
    -webkit-backdrop-filter: blur(20px) saturate(130%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .5), 0 10px 24px rgba(0, 0, 0, .06);
  }

  .hero-alt2[data-stage="0"] .stage-card[data-stage-card="1"] {
    box-shadow: -4px 3px 0 rgba(255, 255, 255, .7), inset 0 1px 0 rgba(255, 255, 255, .5), 0 10px 24px rgba(0, 0, 0, .06);
  }

  .hero-alt2[data-stage="0"] .stage-card[data-stage-card="2"] {
    box-shadow: -3px 2px 0 rgba(255, 255, 255, .82), inset 0 1px 0 rgba(255, 255, 255, .5), 0 10px 24px rgba(0, 0, 0, .06);
  }

  .hero-alt2[data-stage="0"] .stage-card[data-stage-card="3"] {
    background: rgba(255, 255, 255, .18);
    box-shadow: -2px 2px 0 #fff, inset 0 1px 0 rgba(255, 255, 255, .5), 0 10px 24px rgba(0, 0, 0, .06);
  }

  .hero-alt2[data-stage="0"] .stage-card img {
    height: 89%;
    opacity: .9;
  }

  .hero-alt2[data-stage="0"] .stage-card[data-stage-card="0"] img { height: 100%; }
  .scroll-cue { position: absolute; z-index: 8; left: clamp(24px, 7vw, 112px); bottom: 30px; margin: 0; font-size: 11px; letter-spacing: .04em; transition: opacity .15s linear; }

  @media (max-width: 720px) {
    .hero-alt2 { height: 270svh; }
    .hero-alt2-sticky { grid-template-columns: 1fr; grid-template-rows: 44% 56%; }
    .hero-alt2-copy { padding: 54px 24px 12px; }
    .hero-alt2-intro, .detail-copy { top: 54px; left: 24px; width: calc(100% - 48px); }
    .hero-alt2-intro h1 { white-space: normal; }
    .detail-copy { top: 48%; }
    .detail-number { margin-bottom: 14px; }
    .detail-copy h2 { margin-bottom: 12px; font-size: clamp(38px, 12vw, 58px); }
    .detail-eyebrow { margin-bottom: 12px; font-size: 21px; }
    .detail-description { margin-bottom: 16px; font-size: 12px; }
    .stage-card, .stage-card-edge { width: 72vw; height: 46svh; }
    .card-stage { grid-row: 2; }
    .scroll-cue { left: 24px; bottom: 18px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-alt2-intro, .detail-copy, .scroll-cue { transition: none; }
  }
</style>
