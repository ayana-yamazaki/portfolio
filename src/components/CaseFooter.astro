---
import { getCaseStudies } from '../data/site';
import { getLocalizedPath, stripLocalePrefix, type Locale } from '../i18n/locale';
import ResponsiveImage from './ResponsiveImage.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const caseStudies = getCaseStudies(locale);
const currentPath = stripLocalePrefix(Astro.url.pathname);
const isHome = currentPath === '/';
const currentCaseIndex = caseStudies.findIndex((caseStudy) => caseStudy.href === currentPath);

if (currentCaseIndex === -1 && !isHome) {
  throw new Error(`Case study is not registered: ${currentPath}`);
}

const nextCase = isHome ? caseStudies[0] : caseStudies[currentCaseIndex + 1];
const footer: {
  title: string;
  description: string;
  href: string;
  action: string;
  image?: string;
  imageSet?: {
    base: string;
    widths: number[];
    width: number;
    height: number;
  };
  cardImage?: string;
} = nextCase
  ? {
    title: nextCase.title,
    description: nextCase.text,
    href: getLocalizedPath(nextCase.href, locale),
    action: 'View next case',
    image: nextCase.footerImage,
    imageSet: nextCase.footerImageSet,
    cardImage: nextCase.footerCardImage,
  }
  : {
    title: 'How I Build',
    description: locale === 'ja'
      ? '現場を理解し、作るべきものを決め、触れる形まで持っていく。'
      : 'Understand the field, decide what to build, and make it tangible.',
    href: getLocalizedPath('/', locale),
    action: 'Back to overview',
  };
---

<footer class="case-footer">
  <a
    class:list={[
      'case-footer__feature',
      { 'case-footer__feature--with-material': footer.cardImage },
    ]}
    href={footer.href}
  >
    {footer.imageSet ? (
      <ResponsiveImage
        class="case-footer__image"
        base={footer.imageSet.base}
        widths={footer.imageSet.widths}
        width={footer.imageSet.width}
        height={footer.imageSet.height}
        sizes="(max-width: 720px) 72vw, 48vw"
        alt=""
        ariaHidden
        loading="lazy"
        decoding="async"
        fetchpriority="low"
      />
    ) : footer.image && (
      <img
        class="case-footer__image"
        src={footer.image}
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
        fetchpriority="low"
      />
    )}
    <div class="case-footer__feature-inner" data-reveal={isHome ? '' : undefined}>
      <div class="case-footer__title-row">
        {footer.cardImage && (
          <img
            class="case-footer__material"
            src={footer.cardImage}
            width="458"
            height="676"
            alt=""
            aria-hidden="true"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
          />
        )}
        <div class="case-footer__copy">
          <span class="case-footer__label">Case Study</span>
          <h2>{footer.title}</h2>
          <p>{footer.description.split('\n').map((line, index, lines) => <>{line}{index < lines.length - 1 && <br />}</>)}</p>
          {footer.action !== 'View next case' && (
            <span class="case-footer__action">{footer.action} <span aria-hidden="true">↗</span></span>
          )}
        </div>
        <span class="case-footer__arrow" aria-hidden="true">→</span>
      </div>
    </div>
  </a>

  <div class="case-footer__utility" data-reveal={isHome ? '' : undefined}>
    <p>Ayana Yamazaki - Product Builder / Product Designer</p>
    <nav aria-label="Footer navigation">
      <a href={getLocalizedPath('/', locale)}>Home</a>
      <a href="https://x.com/ayana_yamazaki" target="_blank" rel="noreferrer">X / Twitter</a>
      <a href="#top">Back to top ↑</a>
    </nav>
  </div>
</footer>
