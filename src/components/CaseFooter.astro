---
import { caseStudies } from '../data/site';

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';
const currentCaseIndex = caseStudies.findIndex((caseStudy) => caseStudy.href === currentPath);

if (currentCaseIndex === -1 && !isHome) {
  throw new Error(`Case study is not registered: ${currentPath}`);
}

const nextCase = isHome ? caseStudies[0] : caseStudies[currentCaseIndex + 1];
const footer: {
  label: string;
  number?: string;
  title: string;
  description: string;
  href: string;
  action: string;
  image?: string;
} = nextCase
  ? {
    label: isHome ? 'Selected Case' : 'Next Case',
    number: nextCase.number,
    title: nextCase.title,
    description: nextCase.footerDescription,
    href: nextCase.href,
    action: 'View next case',
    image: nextCase.footerImage,
  }
  : {
    label: 'Selected Cases',
    title: 'How I Build',
    description: '現場を理解し、作るべきものを決め、触れる形まで持っていく。',
    href: '/',
    action: 'Back to overview',
  };
---

<footer class="case-footer">
  <a class="case-footer__feature" href={footer.href}>
    {footer.image && <img class="case-footer__image" src={footer.image} alt="" aria-hidden="true" />}
    <div class="case-footer__feature-inner">
      <div class="case-footer__eyebrow">
        <span>{footer.label}</span>
        {footer.number && <span>{footer.number}</span>}
      </div>
      <div class="case-footer__title-row">
        <h2>{footer.title}</h2>
        <span class="case-footer__arrow" aria-hidden="true">→</span>
      </div>
      <p>{footer.description}</p>
      <span class="case-footer__action">{footer.action} <span aria-hidden="true">↗</span></span>
    </div>
  </a>

  <div class="case-footer__utility">
    <p>Ayana Yamazaki — Product Builder</p>
    <nav aria-label="Footer navigation">
      <a href="/">Home</a>
      <a href="https://x.com/ayana_yamazaki" target="_blank" rel="noreferrer">X / Twitter</a>
      <a href="#top">Back to top ↑</a>
    </nav>
  </div>
</footer>
