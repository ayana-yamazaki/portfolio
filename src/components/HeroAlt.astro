---
import panel01 from '../../img/panel01.png';
import panel01Texture from '../../img/panel01-texture.png';
import panel02 from '../../img/panel02.png';
import panel03 from '../../img/panel03.png';
---

<section class="hero-alt">
  <div class="hero-alt-copy">
    <header>
      <p>AYANA YAMAZAKI</p>
      <h1>Product Builder</h1>
    </header>
  </div>
  <div class="hero-alt-panels">
    <div class="hero-panels">
      <div class="hero-panel-edge hero-panel-edge--01 alt-card-edge"><img src={panel01Texture.src} alt="" /></div>
      <div class="hero-panel hero-panel--01 alt-card-face"><img src={panel01.src} alt="" /></div>
      <div class="hero-panel hero-panel--02 alt-card-face"><img src={panel02.src} alt="" /></div>
      <div class="hero-panel hero-panel--03 alt-card-face"><img src={panel03.src} alt="" /></div>
      <a class="alt-panel-caption" data-panel="01" href="/reposaku">Understand Reality</a>
      <a class="alt-panel-caption" data-panel="02" href="/decide-what-to-build">Decide What to Build</a>
      <a class="alt-panel-caption" data-panel="03" href="#projects">Build with AI</a>
    </div>
  </div>
</section>
